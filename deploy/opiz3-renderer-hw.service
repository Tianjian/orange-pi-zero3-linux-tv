[Unit]
Description=OrangePi-Zero3 DLNA renderer (hardware decode + overlay)
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
ExecStartPre=/bin/sh -c 'for i in $(seq 1 30); do ip -4 addr show wlan0 2>/dev/null | grep -q "inet " && exit 0; sleep 1; done; exit 1'
Environment=GST_PLUGIN_FEATURE_RANK=v4l2slh264dec:300,v4l2h264dec:0,avdec_h264:0
ExecStartPre=/usr/bin/modetest -M sun4i-drm -s 51@49:1280x720
User=orangepi
Group=orangepi
SupplementaryGroups=video audio
ExecStart=/usr/bin/gmediarender -f "OrangePi-Zero3 TV" \
  --gstout-videopipe "video/x-raw,format=NV12 ! kmssink plane-id=31" \
  --gstout-audiosink alsasink \
  --gstout-audiodevice "hw:CARD=ahubhdmi,DEV=0" \
  --logfile=/tmp/gmr.log
Restart=always
RestartSec=3
TimeoutStopSec=5
KillSignal=SIGKILL
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
