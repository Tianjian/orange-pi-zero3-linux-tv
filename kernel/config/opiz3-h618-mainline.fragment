# Orange Pi Zero 3 (H618) 主线内核配置片段（upstream v6.6+）
#
# 目标: 用 torvalds/linux 主线（示例 v6.12）自行编译，不依赖 Allwinner 厂商树。
# 用法:
#   make ARCH=arm64 defconfig
#   scripts/kconfig/merge_config.sh -m .config kernel/config/opiz3-h618-mainline.fragment
#   make ARCH=arm64 CROSS_COMPILE=aarch64-none-linux-gnu- olddefconfig
#
# ⚠️ 主线能覆盖大部分外设，但以下需要额外工作（见 docs/09）：
#   - 模拟音频 codec：主线 v6.12 的 sound/soc/sunxi/Kconfig 没有 H616/H618 codec 驱动
#     （厂商树用 SND_SUN50IW9_CODEC/SND_SOC_SUNXI_*），13pin LINEOUT 需厂商补丁或暂缺。
#   - Wi-Fi/BT：UWE5622/AW859A 无主线驱动，需厂商 out-of-tree 模块。
#   - 视频硬解/编码：Cedrus 对 H616 VPU 的支持有限，需实测。
#   - GPU：Panfrost 可编，但 H616 的 GPU 供电/时钟/固件需实测。

CONFIG_ARM64=y
CONFIG_ARCH_SUNXI=y
CONFIG_SUN50I_H616_CCU=y
CONFIG_PINCTRL_SUNXI=y
CONFIG_PINCTRL_SUN50I_H616=y
CONFIG_GPIOLIB=y

CONFIG_MMC=y
CONFIG_MMC_SUNXI=y
CONFIG_MMC_BLOCK=y
CONFIG_MTD=y
CONFIG_MTD_SPI_NOR=y
CONFIG_SPI=y
CONFIG_SPI_SUN6I=y
CONFIG_SPI_SPIDEV=y

CONFIG_I2C=y
CONFIG_I2C_MV64XXX=y
CONFIG_I2C_CHARDEV=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_DW=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_PWM=y
CONFIG_PWM_SUN4I=y

CONFIG_RC_CORE=y
CONFIG_IR_SUNXI=y

CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SUN4I_I2S=y        # I2S（接外部 codec/HDMI 音频时用）
CONFIG_SND_SOC_HDMI_CODEC=y

CONFIG_DRM=y
CONFIG_DRM_SUN4I=y
CONFIG_DRM_SUN8I_DW_HDMI=y
CONFIG_DRM_PANFROST=m

CONFIG_USB=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_HCD_PLATFORM=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_OHCI_HCD_PLATFORM=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=m

CONFIG_NET=y
CONFIG_STMMAC_ETH=y
CONFIG_DWMAC_SUN8I=y
CONFIG_MOTORCOMM_PHY=y

CONFIG_MFD_AXP20X_RSB=y
CONFIG_REGULATOR_AXP20X=y
CONFIG_SUNXI_RSB=y
CONFIG_THERMAL=y
CONFIG_SUN8I_THERMAL=y
CONFIG_WATCHDOG=y
CONFIG_SUNXI_WATCHDOG=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_SUN6I=y
CONFIG_LEDS_GPIO=y
CONFIG_LEDS_TRIGGER_HEARTBEAT=y
CONFIG_NVMEM=y
CONFIG_NVMEM_SUNXI_SID=y

CONFIG_CPU_FREQ=y
CONFIG_CPUFREQ_DT=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLK_DEV_INITRD=y
